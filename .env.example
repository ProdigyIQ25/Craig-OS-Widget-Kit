# Server-only read credential. Never prefix with NEXT_PUBLIC_.
NOTION_TOKEN=
# Separate insert-only connection shared with the 11 XP-04 destinations only.
NOTION_ACTION_TOKEN=
# Random value of at least 32 characters used to sign short-lived CSRF sessions.
ACTION_SIGNING_SECRET=
# Comma-separated exact origins. Production should include only the canonical deployment.
ACTION_ALLOWED_ORIGINS=http://localhost:3000
NOTION_WORKSPACE_ID=
APP_ENV=development
