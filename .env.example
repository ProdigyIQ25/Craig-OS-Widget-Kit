# Server-only read credential. Never prefix with NEXT_PUBLIC_.
NOTION_TOKEN=
# Separate insert-only connection shared with the 11 XP-04 destinations only.
NOTION_ACTION_TOKEN=
# Random value of at least 32 characters used to sign short-lived CSRF sessions.
ACTION_SIGNING_SECRET=
# Comma-separated exact origins. Production should include only the canonical deployment.
ACTION_ALLOWED_ORIGINS=http://localhost:3000
NOTION_WORKSPACE_ID=
APP_ENV=development

# Server-only Template Edition data-source overrides. Leave empty to use the server catalog.
# An explicit empty value unbinds that source and fails closed.
CRAIG_OS_NOTION_PERSONAL_GOALS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PERSONAL_PROJECTS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PERSONAL_TASKS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PERSONAL_DECISIONS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PERSONAL_KNOWLEDGE_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PRAYER_DATA_SOURCE_ID=
CRAIG_OS_NOTION_SPIRITUAL_JOURNAL_DATA_SOURCE_ID=
CRAIG_OS_NOTION_BUSINESS_GOALS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_BUSINESS_PROJECTS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_BUSINESS_TASKS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_BUSINESS_DECISIONS_DATA_SOURCE_ID=
CRAIG_OS_NOTION_BUSINESS_KNOWLEDGE_DATA_SOURCE_ID=
CRAIG_OS_NOTION_COMPANIES_DATA_SOURCE_ID=
CRAIG_OS_NOTION_PEOPLE_DATA_SOURCE_ID=
CRAIG_OS_NOTION_OPPORTUNITIES_DATA_SOURCE_ID=
CRAIG_OS_NOTION_ISSUES_DATA_SOURCE_ID=
